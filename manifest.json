{
  "manifest_version": 3,
  "name": "Focus Timer",
  "version": "1.0",
  "description": "Asks how many minutes, then closes the Facebook/Instagram tab when time is up.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.instagram.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}